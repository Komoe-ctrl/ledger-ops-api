{
  "name": "ledger-ops-api",
  "version": "0.1.0",
  "private": true,
  "description": "API du back-office ledger-ops : grand livre, transactions, rapprochement, audit",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:check-drift": "prisma migrate diff --from-migrations ./prisma/migrations --to-schema ./prisma/schema.prisma --exit-code",
    "db:test:integrity": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f test/integrity.sql",
    "typecheck": "prisma generate && tsc --noEmit",
    "start:dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test:e2e": "jest --config test/e2e/jest-e2e.config.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@testcontainers/postgresql": "^10.13.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "dotenv": "^17.0.0",
    "jest": "^30.0.0",
    "prisma": "7.10.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf": false,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true
  }
}
