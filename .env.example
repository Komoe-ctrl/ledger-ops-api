# Valeurs de développement uniquement. Ne jamais committer de .env réel.
# DATABASE_URL : rôle propriétaire, utilisé par les migrations uniquement.
DATABASE_URL="postgresql://ledger:ledger_dev_only@localhost:5433/ledger"
# APP_DATABASE_URL : rôle applicatif à privilèges minimaux (créé par la
# migration least_privilege_app_role — ADR 0003), utilisé par l'API au
# runtime. Jamais le même rôle que DATABASE_URL.
APP_DATABASE_URL="postgresql://ledger_app:ledger_app_dev_only@localhost:5433/ledger"
REDIS_URL="redis://localhost:6379"
SHADOW_DATABASE_URL="postgresql://ledger:ledger_dev_only@localhost:5433/ledger_shadow"

# Simulateur opérateur (jalon 3) : désactivé par défaut. Nécessite REDIS_URL
# joignable si activé — pas requis sinon (voir ConditionalModule, app.module.ts).
# PROVIDER_SIMULATOR_ENABLED="true"
# PROVIDER_SIMULATOR_FAILURE_RATE="10"

# Cron d'expiration (jalon 3) : activé par défaut. À mettre à "false"
# seulement dans un contexte qui pilote expireOverduePending() lui-même
# (scripts one-shot, tests e2e) — voir app.module.ts.
# EXPIRATION_CRON_ENABLED="false"

# Limite de débit (jalon 5, étape 2) : 60 requêtes/minute/IP, activée par
# défaut. À mettre à "false" seulement en test e2e (déjà fait dans
# global-setup.ts) — voir app.module.ts.
# RATE_LIMIT_ENABLED="false"

# CORS (jalon 5, étape 2) : non configuré = pas de restriction (dev local).
# En déploiement, liste le(s) domaine(s) du front, séparés par des virgules.
# CORS_ALLOWED_ORIGINS="https://ledger-ops-web.vercel.app"

# Pool de connexions Postgres (jalon 5, étape 2) : 5 par défaut, à ajuster
# selon les limites de l'offre Postgres managée utilisée.
# DATABASE_POOL_MAX="5"

# Clés API de démo stables (scripts/seed-demo.ts) : non définies = clé
# aléatoire à chaque exécution (comportement par défaut). Définies = la
# remise à zéro nocturne garde les mêmes clés en clair d'une nuit à l'autre,
# pour que le README/le front n'aient pas une clé invalide chaque matin.
# Format base64url, 43 caractères minimum (même format que les clés émises
# par l'API) ; les deux valeurs doivent être différentes. À générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# DEMO_MERCHANT_API_KEY=""
# DEMO_ANALYST_API_KEY=""
