# Valeurs de développement uniquement. Ne jamais committer de .env réel.
# DATABASE_URL : rôle propriétaire, utilisé par les migrations uniquement.
DATABASE_URL="postgresql://ledger:ledger_dev_only@localhost:5433/ledger"
# APP_DATABASE_URL : rôle applicatif à privilèges minimaux (créé par la
# migration least_privilege_app_role — ADR 0003), utilisé par l'API au
# runtime. Jamais le même rôle que DATABASE_URL.
APP_DATABASE_URL="postgresql://ledger_app:ledger_app_dev_only@localhost:5433/ledger"
REDIS_URL="redis://localhost:6379"
SHADOW_DATABASE_URL="postgresql://ledger:ledger_dev_only@localhost:5433/ledger_shadow"

# Simulateur opérateur (jalon 3) : désactivé par défaut. Nécessite REDIS_URL
# joignable si activé — pas requis sinon (voir ConditionalModule, app.module.ts).
# PROVIDER_SIMULATOR_ENABLED="true"
# PROVIDER_SIMULATOR_FAILURE_RATE="10"

# Cron d'expiration (jalon 3) : activé par défaut. À mettre à "false"
# seulement dans un contexte qui pilote expireOverduePending() lui-même
# (scripts one-shot, tests e2e) — voir app.module.ts.
# EXPIRATION_CRON_ENABLED="false"
